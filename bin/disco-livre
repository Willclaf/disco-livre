#!/bin/zsh
# disco-livre — vigia o espaço do seu Mac e limpa só o que é lixo seguro.
# Licença MIT.

emulate -R zsh
setopt NULL_GLOB
export PATH="/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin:/opt/homebrew/bin:$PATH"

VERSAO="1.4.0"
SCRIPT="${0:A}"
DIR_CONF="${DISCO_LIVRE_DIR:-$HOME/.config/disco-livre}"
CONF="$DIR_CONF/config"
HIST="$DIR_CONF/historico.csv"
ESTADO="$DIR_CONF/estado"
LOG="$HOME/Library/Logs/disco-livre.log"
LABEL="com.disco-livre.vigia"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"

# Padrões — mude com `disco-livre config`
META_GB=30            # espaço livre mínimo que você quer manter
AUTO_LIMPEZA=nao      # limpar o lixo seguro sozinho quando ficar abaixo da meta
LIMPAR_CRASH=sim      # apagar sozinho surtos de relatórios de crash
INTERVALO_HORAS=3     # de quanto em quanto tempo a vigilância roda
LOG_DIAS=7            # logs mais velhos que isso são lixo
ALERTA_QUEDA_GB=10    # avisa se o espaço livre cair isso em 24h
LIMITE_CRASH=500      # quantos relatórios de crash contam como surto
[[ -f $CONF ]] && source "$CONF"

if [[ -t 1 ]]; then
  B=$'\e[1m' D=$'\e[2m' R=$'\e[31m' G=$'\e[32m' Y=$'\e[33m' C=$'\e[36m' N=$'\e[0m'
else
  B= D= R= G= Y= C= N=
fi

# ─── utilitários ────────────────────────────────────────────────────────────

kb()       { du -sk "$1" 2>/dev/null | awk '{print $1+0}'; }

# Roda um comando, mas desiste depois de N segundos. Protege a análise de travar
# enquanto uma janela de permissão do macOS (ex.: "acessar a pasta Downloads") espera resposta.
limitado() {
  local seg=$1; shift
  "$@" &
  local job=$!
  ( sleep $seg; kill $job 2>/dev/null ) &
  local guarda=$!
  wait $job 2>/dev/null
  local rc=$?
  kill $guarda 2>/dev/null
  return $rc
}
kb_antigos() {
  find "$1" -type f -mtime +$LOG_DIAS -print0 2>/dev/null | xargs -0 stat -f%z 2>/dev/null |
    awk '{s+=$1} END{printf "%d\n", s/1024}'
}
# GB/MB decimais, igual ao Finder e aos Ajustes do Sistema
humano()   { awk -v k="${1:-0}" 'BEGIN{ if(k<0)k=-k; b=k*1024; if(b>=1e9) s=sprintf("%.1f GB", b/1e9); else if(b>=1e6) s=sprintf("%.0f MB", b/1e6); else s=sprintf("%d KB", k); gsub(/\./, ",", s); print s }'; }
gb_kb()    { print $(( $1 * 976562 )); }
livre_kb() { df -k "$HOME" | awk 'NR==2{print $4}'; }
total_kb() { df -k "$HOME" | awk 'NR==2{print $2}'; }
curto()    { print -r -- "${1/#$HOME/~}"; }
titulo()   { print -r -- ""; print -r -- "${B}$1${N}"; }
erro()     { print -r -- "${R}✗${N} $1" >&2; exit 1; }
log()      { mkdir -p "${LOG:h}"; print -r -- "$(date '+%F %T') $*" >> "$LOG"; }
avisar()   { osascript -e "display notification \"${2//\"/\'}\" with title \"${1//\"/\'}\"" >/dev/null 2>&1; }
confirmar() { local r; read -r "r?$1 [s/N] " || return 1; [[ $r == [sSyY]* ]]; }
ativo()    { launchctl print "gui/$UID/$LABEL" >/dev/null 2>&1; }


# Só avisa de novo depois de N segundos (evita spam de notificação)
pode_avisar() {
  local agora=$(date +%s) ult
  ult=$(grep "^$1=" "$ESTADO" 2>/dev/null | cut -d= -f2)
  (( agora - ${ult:-0} < $2 )) && return 1
  mkdir -p "$DIR_CONF"
  { grep -v "^$1=" "$ESTADO" 2>/dev/null; print "$1=$agora"; } > "$ESTADO.tmp" && mv "$ESTADO.tmp" "$ESTADO"
}

barra() {
  local usado=$1 total=$2 w=30 n i s=""
  n=$(( usado * w / total ))
  for (( i = 0; i < w; i++ )); do
    (( i < n )) && s+="█" || s+="░"
  done
  print -rn -- "$s"
}

# ─── catálogo do que dá pra limpar ─────────────────────────────────────────
# nivel|tipo|descrição|caminho|quem precisa estar fechado|nota
#   nivel:  seguro  = se recria sozinho (limpeza automática pode apagar)
#           revisar = é da pessoa; só sai se ela marcar, e vai pra Lixeira
#   tipo:   conteudo        apaga tudo dentro da pasta (a pasta fica)
#           antigos         apaga arquivos com mais de $LOG_DIAS dias
#           electron        apaga os caches internos de um app Electron
#           lixeira-pasta   manda a pasta inteira pra Lixeira
#           lixeira-antigos:DIAS:PROFUNDIDADE:PADRÕES  manda arquivos velhos pra Lixeira
#   fechado: "-" ninguém · "?" descobre sozinho (lsof) · "Nome" processo que não pode estar aberto

crashpads() {
  print -rl -- "$HOME/Library/Application Support"/*/Crashpad(N/) \
               "$HOME/Library/Application Support"/*/*/Crashpad(N/) \
               "$HOME/Library/Caches"/*/Crashpad(N/)
}

ELECTRON_CACHES=(Cache "Code Cache" GPUCache DawnGraphiteCache DawnWebGPUCache GrShaderCache ShaderCache)

electron_dirs() {
  local s
  for s in $ELECTRON_CACHES; do [[ -d $1/$s ]] && print -r -- "$1/$s"; done
}

alvos() {
  local c s a L="$HOME/Library" AS="$HOME/Library/Application Support" CA="$HOME/Library/Caches"
  # relatórios de crash de qualquer app
  for c in ${(f)"$(crashpads)"}; do
    for s in pending completed new; do
      [[ -d $c/$s ]] && print -r -- "seguro|conteudo|Relatórios de crash — ${c:h:t}|$c/$s|-|"
    done
  done
  print -r -- "seguro|antigos|Logs com mais de $LOG_DIAS dias|$L/Logs|-|"

  # navegadores
  print -r -- "seguro|conteudo|Cache do Chrome|$CA/Google/Chrome|Google Chrome|"
  print -r -- "seguro|conteudo|Cache do Edge|$CA/Microsoft Edge|Microsoft Edge|"
  print -r -- "seguro|conteudo|Cache do Brave|$CA/BraveSoftware|Brave Browser|"
  print -r -- "seguro|conteudo|Cache do Opera GX|$CA/com.operasoftware.OperaGX|Opera GX|"
  print -r -- "seguro|conteudo|Cache do Arc|$CA/Arc|Arc.app|"
  print -r -- "seguro|conteudo|Cache do Firefox|$CA/Firefox|firefox|"

  # criação
  print -r -- "seguro|conteudo|Cache do Camera Raw (Lightroom/Photoshop)|$CA/Adobe Camera Raw 2|Lightroom|"
  print -r -- "seguro|conteudo|Cache do Spotify|$CA/com.spotify.client|Spotify|"

  # IA
  print -r -- "seguro|conteudo|Cache do Codex|$CA/Codex|?|"
  print -r -- "seguro|conteudo|Runtimes baixados do Codex|$HOME/.cache/codex-runtimes|?|Baixados de novo quando o Codex precisar"
  print -r -- "seguro|conteudo|Cache do Claude Code|$CA/claude-cli-nodejs|?|"
  print -r -- "seguro|conteudo|Cache do Hugging Face (Xet)|$HOME/.cache/huggingface/xet|?|"

  # programação
  print -r -- "seguro|conteudo|Cache do npm|$HOME/.npm/_cacache|-|"
  print -r -- "seguro|conteudo|Cache do pip|$CA/pip|-|"
  print -r -- "seguro|conteudo|Cache do uv (Python)|$HOME/.cache/uv|?|"
  print -r -- "seguro|conteudo|Cache do pnpm|$CA/pnpm|-|"
  print -r -- "seguro|conteudo|Cache do Yarn|$CA/Yarn|-|"
  print -r -- "seguro|conteudo|Cache do Homebrew|$CA/Homebrew|brew|"
  print -r -- "seguro|conteudo|Cache do Go|$CA/go-build|-|"
  print -r -- "seguro|conteudo|Cache do CocoaPods|$CA/CocoaPods|-|"
  print -r -- "seguro|conteudo|Xcode DerivedData|$L/Developer/Xcode/DerivedData|Xcode.app|"

  # atualizações já baixadas
  for c in "$CA"/*ShipIt(N/); do
    print -r -- "seguro|conteudo|Atualização já baixada — ${${c:t:r}##*.}|$c|-|"
  done

  # caches internos de apps Electron (Claude, Codex, Cursor, VS Code, Slack, Discord, Figma…)
  for a in "$AS"/*(N/); do
    [[ -n $(electron_dirs "$a") ]] && print -r -- "seguro|electron|Cache do app ${${a:t}##*.}|$a|?|"
  done

  # revisar: é da pessoa, vai pra Lixeira
  print -r -- "revisar|lixeira-antigos:14:1:*.dmg *.pkg *.iso *.xip|Instaladores antigos em Downloads|$HOME/Downloads|-|Arquivos .dmg/.pkg com mais de 14 dias. Vão pra Lixeira"
  print -r -- "revisar|lixeira-antigos:90:6:*.jsonl|Conversas do Codex com mais de 90 dias|$HOME/.codex/sessions|?|O histórico antigo some do Codex. Vai pra Lixeira"
  print -r -- "revisar|lixeira-pasta|Modelos de IA do Hugging Face|$HOME/.cache/huggingface/hub|?|Baixados de novo se algum programa precisar. Vai pra Lixeira"
  print -r -- "revisar|conteudo|Navegadores do Playwright|$CA/ms-playwright|?|Automações com Playwright precisarão baixar de novo"
  print -r -- "revisar|conteudo|Suporte a iPhone do Xcode|$L/Developer/Xcode/iOS DeviceSupport|Xcode.app|O Xcode recria ao conectar o iPhone"
}

# formato antigo (tipo|descrição|caminho|fechado), só o que é seguro
alvos_seguros() {
  local nivel tipo desc cam cond nota
  alvos | while IFS='|' read -r nivel tipo desc cam cond nota; do
    [[ $nivel == seguro ]] && print -r -- "$tipo|$desc|$cam|$cond"
  done
}

arquivos_antigos() {   # $1 = lixeira-antigos:DIAS:PROF:PADRÕES  $2 = pasta  → lista separada por \0
  local -a p pads expr
  p=("${(@s.:.)1}")
  pads=(${=p[4]})
  local x
  for x in $pads; do expr+=(-o -iname "$x"); done
  expr=("${(@)expr[2,-1]}")
  limitado 20 find "$2" -maxdepth $p[3] -type f \( "${(@)expr}" \) -mtime +$p[2] -print0 2>/dev/null
}

soma_kb() { xargs -0 stat -f%z 2>/dev/null | awk '{s+=$1} END{printf "%d\n", s/1024}'; }

medir() {
  local t=0 d
  case $1 in
    conteudo|lixeira-pasta) kb "$2" ;;
    antigos)  kb_antigos "$2" ;;
    electron) for d in ${(f)"$(electron_dirs "$2")"}; do (( t += $(kb "$d") )); done; print $t ;;
    lixeira-antigos:*) arquivos_antigos "$1" "$2" | soma_kb ;;
  esac
}

# Quem está usando? Vazio = pode limpar. Senão, o nome do app que precisa fechar.
quem_usa() {
  local tipo=$1 cam=$2 cond=$3 nome d
  case $cond in
    -|"") return 0 ;;
    \?)
      local -a dirs
      if [[ $tipo == electron ]]; then dirs=(${(f)"$(electron_dirs "$cam")"}); else dirs=("$cam"); fi
      for d in $dirs; do
        nome=$(lsof +D "$d" -Fc 2>/dev/null | sed -n 's/^c//p' | head -1)
        if [[ -n $nome ]]; then
          nome=${nome//\\x20/ }
          nome=${${${nome% Helper*}% \(*}%.app}
          print -r -- "$nome"
          return 0
        fi
      done ;;
    *)
      pgrep -fi -- "$cond" >/dev/null 2>&1 && print -r -- "${${cond//|/ ou }%.app}" ;;
  esac
}

# Manda pra Lixeira (recuperável). macOS 15+: /usr/bin/trash; antes disso, pelo Finder.
mandar_lixeira() {
  (( $# )) || return 0
  if [[ -x /usr/bin/trash ]]; then
    /usr/bin/trash "$@" 2>/dev/null
  else
    local f
    for f; do
      osascript -e 'on run a' -e 'tell application "Finder" to delete (POSIX file (item 1 of a) as alias)' -e 'end run' "$f" >/dev/null 2>&1
    done
  fi
  return 0
}

apagar_alvo() {
  local d
  # modo de teste: faz tudo, menos apagar
  [[ -n $DISCO_LIVRE_SIMULAR ]] && { print -r -- "[simulado] $1 $2" >> "$DIR_CONF/simulado.log"; return 0; }
  case $1 in
    conteudo) find "$2" -mindepth 1 -delete 2>/dev/null ;;
    antigos)  find "$2" -type f -mtime +$LOG_DIAS -delete 2>/dev/null
              find "$2" -mindepth 1 -type d -empty -delete 2>/dev/null ;;
    electron) for d in ${(f)"$(electron_dirs "$2")"}; do find "$d" -mindepth 1 -delete 2>/dev/null; done ;;
    lixeira-pasta) mandar_lixeira "$2" ;;
    lixeira-antigos:*) mandar_lixeira ${(0)"$(arquivos_antigos "$1" "$2")"} ;;
  esac
  return 0
}

vai_pra_lixeira() { [[ $1 == lixeira-* ]]; }

# ─── dicas pras pastas grandes ─────────────────────────────────────────────

dica() {
  case $1 in
    */Crashpad*)                 print "Relatórios de crash — lixo. disco-livre limpar" ;;
    *"Adobe Camera Raw"*)        print "Cache do Lightroom. Lightroom → Ajustes → Desempenho: mude pro HD externo e limite o tamanho" ;;
    */Application\ Support/Google/Chrome|*/Application\ Support/Google) print "Perfis do Chrome (favoritos, logins). Apague perfis que não usa pelo próprio Chrome" ;;
    */Caches/Google*)            print "Cache do Chrome — disco-livre limpar (com o Chrome fechado)" ;;
    */.lmstudio*|*/.ollama*|*huggingface*) print "Modelos de IA locais. Apague os que não usa ou mova pro HD externo pelo app" ;;
    */.codex)                    print "Codex: histórico de conversas (sessions) e plugins. Arquive sessões antigas" ;;
    */Application\ Support/Codex) print "App do Codex. Se for grande, veja a pasta Crashpad dentro dela" ;;
    */Documents/Codex)           print "Pastas de trabalho que o Codex cria por data pra tarefas sem projeto" ;;
    */Claude/vm_bundles|*/Application\ Support/Claude) print "Claude Desktop (inclui a máquina virtual do Cowork)" ;;
    */.claude)                   print "Claude Code: histórico de sessões e projetos" ;;
    */Movies/.gallery)           print "Stills da galeria do DaVinci Resolve. disco-livre mover pro HD externo" ;;
    */CacheClip*)                print "Cache de render do DaVinci. No Resolve: Playback → Delete Render Cache" ;;
    */Blackmagic\ Design)        print "DaVinci Resolve (bancos de projetos, LUTs)" ;;
    */MobileSync*)               print "Backups de iPhone/iPad. Finder → seu iPhone → Gerenciar backups" ;;
    */Developer/CoreSimulator)   print "Simuladores iOS. xcrun simctl delete unavailable" ;;
    */Developer/Xcode)           print "Xcode (DerivedData, arquivos de iOS). disco-livre limpar limpa o DerivedData" ;;
    *[Dd]ocker*)                 print "Docker. docker system prune pra limpar imagens velhas" ;;
    */Steam)                     print "Jogos da Steam. Desinstale ou mova a biblioteca pelo app" ;;
    */Downloads)                 print "Downloads. Apague instaladores (.dmg, .zip, .pkg) antigos" ;;
    */Desktop)                   print "Mesa (Desktop). Capturas de tela costumam acumular aqui" ;;
    */.npm|*/.cache|*/pnpm|*/Caches/pip) print "Cache de programação — disco-livre limpar" ;;
    */Library/Logs)              print "Logs — disco-livre limpar apaga os antigos" ;;
    */Library/Containers)        print "Dados de apps da App Store. Veja qual app pesa em Ajustes → Armazenamento" ;;
    *WhatsApp*|*Telegram*)       print "Mídia de conversas. Limpe pelo próprio app (Armazenamento)" ;;
    */Caches/*)                  print "Cache de app — costuma ser seguro apagar com o app fechado" ;;
    */Pictures/*.photoslibrary)  print "Fotos. Ative 'Otimizar armazenamento' no app Fotos" ;;
    */Music/*)                   print "Música/podcasts baixados" ;;
  esac
}

# ─── comandos ──────────────────────────────────────────────────────────────

cmd_status() {
  local livre=$(livre_kb) total=$(total_kb) meta=$(( $(gb_kb $META_GB) ))
  print -r -- "${B}disco-livre${N} ${D}$VERSAO${N}"
  print -r -- ""
  printf "  Espaço livre: %s%s%s de %s\n" "$B" "$(humano $livre)" "$N" "$(humano $total)"
  printf "  %s\n" "$(barra $(( total - livre )) $total)"
  if (( livre >= meta )); then
    printf "  Meta: %s GB livres  %s✓ dentro da meta%s (%s de folga)\n" "$META_GB" "$G" "$N" "$(humano $(( livre - meta )))"
  else
    printf "  Meta: %s GB livres  %s✗ faltam %s%s → disco-livre analisar\n" "$META_GB" "$R" "$(humano $(( meta - livre )))" "$N"
  fi
  print -r -- ""
  if ativo; then
    print -r -- "  Vigilância automática: ${G}ligada${N} (a cada ${INTERVALO_HORAS}h)"
  else
    print -r -- "  Vigilância automática: ${Y}desligada${N} → disco-livre ativar"
  fi
  print -r -- "  Limpeza automática abaixo da meta: $AUTO_LIMPEZA  ${D}(disco-livre config auto-limpeza sim|nao)${N}"
  print -r -- ""
  print -r -- "  ${D}disco-livre ajuda — lista todos os comandos${N}"
}

cmd_limpar() {
  local executar=0 sim=0 silencioso=0 a
  for a; do
    case $a in
      --executar)   executar=1 ;;
      --sim|-y)     sim=1 ;;
      --silencioso) silencioso=1 ;;
      *) erro "opção desconhecida: $a" ;;
    esac
  done

  local -a fila
  local total=0 tipo desc cam bloq t
  while IFS='|' read -r t desc bloq tipo cam; do
    if (( bloq )); then
      (( silencioso )) || printf "  %s%-9s%s %s %s(feche o app pra limpar)%s\n" "$D" "$(humano $t)" "$N" "$desc" "$Y" "$N"
      continue
    fi
    fila+=("$tipo|$cam|$desc|$t")
    (( total += t ))
    (( silencioso )) || printf "  %s%-9s%s %s\n" "$B" "$(humano $t)" "$N" "$desc"
  done < <(listar_lixo)

  LIBERADO_KB=0
  if (( ${#fila} == 0 )); then
    (( silencioso )) || print -r -- "  ${G}Nada pra limpar agora.${N}"
    return 0
  fi
  (( silencioso )) || print -r -- "  ${B}Total: $(humano $total)${N}"

  if (( ! executar )); then
    print -r -- "  ${D}Simulação — nada foi apagado. Pra apagar: ${N}${C}disco-livre limpar --executar${N}"
    return 0
  fi
  if (( ! sim )) && ! confirmar "Apagar $(humano $total) de lixo seguro?"; then
    print -r -- "Cancelado."
    return 0
  fi

  local antes=$(livre_kb) item
  for item in $fila; do
    IFS='|' read -r tipo cam desc t <<< "$item"
    apagar_alvo $tipo "$cam"
    log "limpou: $desc ($(humano $t))"
  done
  LIBERADO_KB=$total
  (( silencioso )) || print -r -- "  ${G}✓ Limpo.${N} Livre agora: $(humano $(livre_kb)) (antes $(humano $antes))"
}

# ─── coleta (saída em linhas campo|campo, usada pelo terminal e pelo app) ──

# kb|descrição|bloqueado(0/1)|tipo|caminho|quem está usando
listar_lixo() {
  local tipo desc cam cond t quem
  while IFS='|' read -r tipo desc cam cond; do
    [[ -d $cam ]] || continue
    t=$(medir $tipo "$cam")
    (( t < 1024 )) && continue
    quem=$(quem_usa "$tipo" "$cam" "$cond")
    print -r -- "$t|$desc|${${quem:+1}:-0}|$tipo|$cam|$quem"
  done < <(alvos_seguros)
}

id_de() { md5 -qs "$1|$2" | cut -c1-8; }

# id|nivel|kb|quem está usando|descrição|nota|tipo|caminho — tudo que a análise geral encontra
listar_geral() {
  local nivel tipo desc cam cond nota t
  while IFS='|' read -r nivel tipo desc cam cond nota; do
    [[ -e $cam ]] || continue
    t=$(medir "$tipo" "$cam")
    (( t < 5120 )) && continue
    print -r -- "$(id_de "$tipo" "$cam")|$nivel|$t|$(quem_usa "$tipo" "$cam" "$cond")|$desc|$nota|$tipo|$cam"
  done < <(alvos) | sort -t'|' -k2,2r -k3,3nr
}

# n|kb|app|pasta — só apps acima do limite de crash
listar_crashes() {
  local c n
  for c in ${(f)"$(crashpads)"}; do
    n=$(find "$c" -type f 2>/dev/null | wc -l | tr -d ' ')
    (( n > LIMITE_CRASH )) && print -r -- "$n|$(kb "$c")|${c:h:t}|$c"
  done
}

# tipo(reabre|erro)|label|app ou código|programa
listar_tarefas() {
  local lista desativadas f label linha pid st prog ka
  lista=$(launchctl list 2>/dev/null)
  desativadas=$(launchctl print-disabled "gui/$UID" 2>/dev/null)
  for f in "$HOME/Library/LaunchAgents"/*.plist(N); do
    label=$(/usr/libexec/PlistBuddy -c 'Print :Label' "$f" 2>/dev/null) || continue
    print -r -- "$desativadas" | grep -qF "\"$label\" => disabled" && continue
    print -r -- "$desativadas" | grep -qF "\"$label\" => true" && continue
    linha=$(print -r -- "$lista" | awk -v l="$label" '$3==l')
    [[ -z $linha ]] && continue
    pid=${${=linha}[1]} st=${${=linha}[2]}
    prog=$(/usr/libexec/PlistBuddy -c 'Print :ProgramArguments:0' "$f" 2>/dev/null ||
           /usr/libexec/PlistBuddy -c 'Print :Program' "$f" 2>/dev/null)
    ka=$(/usr/libexec/PlistBuddy -c 'Print :KeepAlive' "$f" 2>/dev/null)
    if [[ $prog == *.app/Contents/MacOS/* && -n $ka && $ka != false ]]; then
      print -r -- "reabre|$label|${${prog%%.app/*}:t}|$prog"
    elif [[ $pid == - && $st != 0 ]]; then
      print -r -- "erro|$label|$st|$prog"
    fi
  done
}

# app|porta|perfil
listar_remoto() {
  local l exe porta perfil
  ps -axo command= | grep -E -- '--remote-debugging-port=[0-9]+' | grep -v -- '--type=' | grep -v grep |
  while read -r l; do
    exe=${${l%%.app/*}:t}
    porta=${l##*--remote-debugging-port=}; porta=${porta%% *}
    perfil=""
    [[ $l == *--user-data-dir=* ]] && perfil=${${l##*--user-data-dir=}%% --*}
    print -r -- "$exe|$porta|$perfil"
  done
}

# kb|caminho — as N maiores pastas
listar_maiores() {
  local -a cands
  cands=(
    "$HOME/Library/Application Support"/*(N/)
    "$HOME/Library/Caches"/*(N/)
    "$HOME/Library/Group Containers"/*(N/)
    "$HOME/Library/Developer"/*(N/)
    "$HOME/Library/Containers" "$HOME/Library/Logs"
    "$HOME"/.*(N/)
    "$HOME/Movies"/*(N/) "$HOME/Movies"/.*(N/)
    "$HOME/Documents"/*(N/) "$HOME/Documents"/.*(N/)
    "$HOME/Pictures"/*(N/) "$HOME/Music"/*(N/)
    "$HOME/Downloads" "$HOME/Desktop"
  )
  local p t
  for p in $cands; do
    [[ ${p:t} == .Trash ]] && continue
    t=$(limitado 30 kb "$p")
    (( t >= 524288 )) && print -r -- "$t|$p"
  done | sort -t'|' -k1,1nr | head -n ${1:-15}
}

oculta() { [[ ${1#$HOME} == */.* ]]; }

# ─── relatórios no terminal ───────────────────────────────────────────────

maiores() {
  local t p d marca
  listar_maiores ${1:-15} | while IFS='|' read -r t p; do
    marca=""
    oculta "$p" && marca=" ${Y}(oculta no Finder)${N}"
    printf "  %s%-9s%s %s%s\n" "$B" "$(humano $t)" "$N" "$(curto "$p")" "$marca"
    d=$(dica "$p")
    [[ -n $d ]] && print -r -- "            ${D}↳ $d${N}"
  done
}

tarefas() {
  local achou=0 tipo label info prog
  while IFS='|' read -r tipo label info prog; do
    achou=1
    if [[ $tipo == reabre ]]; then
      print -r -- "  ${Y}⚠${N} ${B}$label${N} abre ${B}$info${N} sozinho e ${Y}reabre se você fechar${N}"
      print -r -- "            ${D}↳ Se não reconhece: disco-livre pausar-tarefa $label${N}"
    else
      print -r -- "  ${R}✗${N} ${B}$label${N} está terminando com erro (código $info)"
      print -r -- "            ${D}↳ $(curto "$prog")${N}"
      print -r -- "            ${D}↳ Se não usa mais: disco-livre pausar-tarefa $label${N}"
    fi
  done < <(listar_tarefas)
  (( achou )) || print -r -- "  ${G}Nenhuma tarefa com problema.${N}"
}

controle_remoto() {
  local achou=0 exe porta perfil
  while IFS='|' read -r exe porta perfil; do
    achou=1
    print -r -- "  ${Y}⚠${N} ${B}$exe${N} está com controle remoto ligado (porta $porta)"
    [[ -n $perfil ]] && print -r -- "            ${D}↳ perfil: $(curto "$perfil")${N}"
    print -r -- "            ${D}↳ Qualquer programa do Mac pode comandar esse navegador. Se não é uma automação sua, feche.${N}"
  done < <(listar_remoto)
  (( achou )) || print -r -- "  ${G}Nenhum navegador sendo controlado.${N}"
}

surtos_crash() {
  local achou=0 n t app c
  while IFS='|' read -r n t app c; do
    achou=1
    print -r -- "  ${R}✗${N} ${B}$app${N} gerou ${B}$n${N} relatórios de crash ($(humano $t))"
    print -r -- "            ${D}↳ O app está travando em loop. Limpe e reinicie/atualize o app.${N}"
  done < <(listar_crashes)
  (( achou )) || print -r -- "  ${G}Nenhum app crashando em massa.${N}"
}

# variação do espaço livre em 7 dias (KB); vazio se não há histórico
tendencia_kb() {
  [[ -f $HIST ]] || return 0
  local ref
  ref=$(awk -F, -v t=$(( $(date +%s) - 7*86400 )) '$1>=t {print $2; exit}' "$HIST")
  [[ -n $ref ]] && print $(( $(livre_kb) - ref ))
}

tendencia() {
  local dif=$(tendencia_kb)
  [[ -z $dif ]] && return 0
  if (( dif < -1048576 )); then
    print -r -- "  ${Y}Últimos 7 dias: você perdeu $(humano $dif) de espaço livre${N}"
  elif (( dif > 1048576 )); then
    print -r -- "  ${G}Últimos 7 dias: você ganhou $(humano $dif) de espaço livre${N}"
  fi
}

cmd_analisar() {
  registrar
  cmd_status
  tendencia

  titulo "1. Lixo seguro (é recriado sozinho)"
  cmd_limpar

  titulo "2. Apps crashando em massa"
  surtos_crash

  titulo "3. Maiores pastas pra revisar ${D}(medindo… pode levar um minuto)${N}"
  maiores 15

  titulo "4. Tarefas em segundo plano"
  tarefas

  titulo "5. Navegadores com controle remoto"
  controle_remoto

  local lixeira snaps
  lixeira=$(kb "$HOME/.Trash")
  snaps=$(tmutil listlocalsnapshots / 2>/dev/null | grep -c 'com.apple')
  if (( lixeira > 102400 || snaps > 0 )); then
    titulo "6. Outros"
    (( lixeira > 102400 )) && print -r -- "  Lixeira com ${B}$(humano $lixeira)${N} — esvazie pelo Finder"
    (( snaps > 0 )) && print -r -- "  $snaps snapshot(s) local(is) do Time Machine ${D}(o macOS apaga sozinho quando precisar de espaço)${N}"
  fi
  print -r -- ""
}

registrar() {
  mkdir -p "$DIR_CONF"
  print -r -- "$(date +%s),$(livre_kb)" >> "$HIST"
  # guarda só os últimos ~60 dias (a cada 3h ≈ 500 linhas)
  if (( $(wc -l < "$HIST") > 1000 )); then
    tail -n 500 "$HIST" > "$HIST.tmp" && mv "$HIST.tmp" "$HIST"
  fi
}

cmd_vigiar() {
  registrar
  local livre=$(livre_kb) meta=$(( $(gb_kb $META_GB) )) c n tam s

  # 1) surto de crash — o problema que enche o disco em poucos dias
  for c in ${(f)"$(crashpads)"}; do
    n=$(find "$c" -type f 2>/dev/null | wc -l | tr -d ' ')
    (( n > LIMITE_CRASH )) || continue
    tam=$(kb "$c")
    if [[ $LIMPAR_CRASH == sim ]]; then
      for s in pending completed new; do [[ -d $c/$s ]] && find "$c/$s" -mindepth 1 -delete 2>/dev/null; done
      log "surto de crash: ${c:h:t} — apagou $n relatórios ($(humano $tam))"
      avisar "${c:h:t} está crashando sem parar" "Apaguei $n relatórios de crash ($(humano $tam)). Vale reiniciar ou atualizar o app."
    else
      log "surto de crash: ${c:h:t} — $n relatórios ($(humano $tam))"
      avisar "${c:h:t} está crashando sem parar" "$n relatórios de crash ($(humano $tam)). Rode: disco-livre limpar"
    fi
  done
  livre=$(livre_kb)

  # 2) queda rápida — algo novo está enchendo o disco
  local maximo queda
  maximo=$(awk -F, -v t=$(( $(date +%s) - 86400 )) '$1>=t && $2>m {m=$2} END{print m+0}' "$HIST")
  queda=$(( maximo - livre ))
  if (( queda > $(gb_kb $ALERTA_QUEDA_GB) )) && pode_avisar queda 43200; then
    log "queda rápida: -$(humano $queda) em 24h"
    avisar "Seu disco está enchendo rápido" "Você perdeu $(humano $queda) nas últimas 24h. Rode: disco-livre analisar"
  fi

  # 3) versão nova (confere no máximo uma vez por dia)
  if pode_avisar versao 86400; then
    local nova=$(ultima_versao)
    mais_nova "$nova" "$VERSAO" && avisar "Disco Livre $nova chegou" "Abra o app e clique em Atualizar, ou rode: disco-livre atualizar"
  fi

  # 4) meta de espaço livre
  if (( livre < meta )); then
    if [[ $AUTO_LIMPEZA == sim ]]; then
      cmd_limpar --executar --sim --silencioso
      livre=$(livre_kb)
      (( LIBERADO_KB > 0 )) && avisar "Limpeza automática" "Liberei $(humano $LIBERADO_KB). Agora: $(humano $livre) livres."
    fi
    if (( livre < meta )) && pode_avisar meta 21600; then
      log "abaixo da meta: $(humano $livre) livres (meta $META_GB GB)"
      avisar "Pouco espaço: $(humano $livre) livres" "Sua meta é $META_GB GB. Rode: disco-livre analisar"
    fi
  fi
}

salvar_config() {
  mkdir -p "$DIR_CONF"
  cat > "$CONF" <<EOF
# disco-livre — configuração (edite à vontade ou use: disco-livre config)
META_GB=$META_GB
AUTO_LIMPEZA=$AUTO_LIMPEZA
LIMPAR_CRASH=$LIMPAR_CRASH
INTERVALO_HORAS=$INTERVALO_HORAS
LOG_DIAS=$LOG_DIAS
ALERTA_QUEDA_GB=$ALERTA_QUEDA_GB
LIMITE_CRASH=$LIMITE_CRASH
EOF
}

cmd_config() {
  if (( $# == 0 )); then
    print -r -- "${B}Configuração${N} ${D}($(curto "$CONF"))${N}"
    print -r -- "  meta           $META_GB GB      espaço livre mínimo"
    print -r -- "  auto-limpeza   $AUTO_LIMPEZA        limpar lixo seguro sozinho abaixo da meta"
    print -r -- "  limpar-crash   $LIMPAR_CRASH        apagar sozinho surtos de crash"
    print -r -- "  intervalo      ${INTERVALO_HORAS}h        de quanto em quanto tempo vigiar"
    print -r -- "  logs-dias      $LOG_DIAS          idade pra log virar lixo"
    print -r -- "  alerta-queda   $ALERTA_QUEDA_GB GB      avisar se perder isso em 24h"
    print -r -- ""
    print -r -- "  ${D}Ex.: disco-livre config meta 30${N}"
    return 0
  fi
  local chave=$1 valor=$2
  case $chave in
    meta)         [[ $valor == <1-> ]] || erro "use: disco-livre config meta 30"; META_GB=$valor ;;
    auto-limpeza) [[ $valor == (sim|nao) ]] || erro "use: sim ou nao"; AUTO_LIMPEZA=$valor ;;
    limpar-crash) [[ $valor == (sim|nao) ]] || erro "use: sim ou nao"; LIMPAR_CRASH=$valor ;;
    intervalo)    [[ $valor == <1-24> ]] || erro "use um número de horas (1 a 24)"; INTERVALO_HORAS=$valor ;;
    logs-dias)    [[ $valor == <1-> ]] || erro "use um número de dias"; LOG_DIAS=$valor ;;
    alerta-queda) [[ $valor == <1-> ]] || erro "use um número em GB"; ALERTA_QUEDA_GB=$valor ;;
    *) erro "opção desconhecida: $chave (veja: disco-livre config)" ;;
  esac
  salvar_config
  print -r -- "${G}✓${N} $chave = $valor"
  [[ $chave == intervalo ]] && ativo && cmd_ativar
  return 0
}

cmd_ativar() {
  [[ -f $CONF ]] || salvar_config
  mkdir -p "${PLIST:h}"
  cat > "$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key><array><string>$SCRIPT</string><string>vigiar</string></array>
  <key>StartInterval</key><integer>$(( INTERVALO_HORAS * 3600 ))</integer>
  <key>RunAtLoad</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
  <key>Nice</key><integer>10</integer>
</dict></plist>
EOF
  launchctl bootout "gui/$UID/$LABEL" 2>/dev/null
  launchctl enable "gui/$UID/$LABEL" 2>/dev/null
  launchctl bootstrap "gui/$UID" "$PLIST" || erro "não consegui ativar a vigilância"
  print -r -- "${G}✓${N} Vigilância ligada: confere o disco a cada ${INTERVALO_HORAS}h e te avisa abaixo de $META_GB GB livres."
}

cmd_desativar() {
  launchctl bootout "gui/$UID/$LABEL" 2>/dev/null
  rm -f "$PLIST"
  print -r -- "${G}✓${N} Vigilância desligada."
}

plist_da_tarefa() {
  local f
  for f in "$HOME/Library/LaunchAgents"/*.plist(N); do
    [[ $(/usr/libexec/PlistBuddy -c 'Print :Label' "$f" 2>/dev/null) == $1 ]] && { print -r -- "$f"; return 0; }
  done
  return 1
}

cmd_pausar_tarefa() {
  [[ -n $1 ]] || erro "use: disco-livre pausar-tarefa <nome-da-tarefa>"
  plist_da_tarefa "$1" >/dev/null || erro "não achei a tarefa $1 em ~/Library/LaunchAgents"
  launchctl bootout "gui/$UID/$1" 2>/dev/null
  launchctl disable "gui/$UID/$1"
  log "pausou tarefa: $1"
  print -r -- "${G}✓${N} $1 parada e não volta ao reiniciar. Pra religar: disco-livre religar-tarefa $1"
}

cmd_religar_tarefa() {
  [[ -n $1 ]] || erro "use: disco-livre religar-tarefa <nome-da-tarefa>"
  local f
  f=$(plist_da_tarefa "$1") || erro "não achei a tarefa $1 em ~/Library/LaunchAgents"
  launchctl enable "gui/$UID/$1"
  launchctl bootstrap "gui/$UID" "$f" 2>/dev/null
  log "religou tarefa: $1"
  print -r -- "${G}✓${N} $1 religada."
}

contar() { find "$1" -type f ! -name .DS_Store ! -name '._*' 2>/dev/null | wc -l | tr -d ' '; }
bytes()  { find "$1" -type f ! -name .DS_Store ! -name '._*' -print0 2>/dev/null | xargs -0 stat -f%z 2>/dev/null | awk '{s+=$1} END{printf "%d\n", s}'; }

cmd_mover() {
  (( $# == 2 )) || erro "use: disco-livre mover <pasta> <pasta-de-destino-no-HD-externo>"
  local entrada=${1%/}
  [[ -L $entrada ]] && erro "$entrada já é um atalho — já foi movida"
  [[ -d $entrada ]] || erro "pasta não encontrada: $entrada"
  [[ -d $2 ]] || erro "destino não existe: $2 (o HD está conectado?)"
  local orig=${entrada:A} dest=${2:A}
  [[ $orig == $HOME/* ]] || erro "por segurança, só movo pastas dentro de $(curto $HOME)"
  [[ $dest == $orig || $dest == $orig/* ]] && erro "o destino não pode ficar dentro da própria pasta"

  local nome=${orig:t}
  local final="$dest/${nome#.}"
  [[ -e $final ]] && erro "já existe $final"

  local tam=$(kb "$orig") livre_dest
  livre_dest=$(df -k "$dest" | awk 'NR==2{print $4}')
  (( livre_dest > tam + 1048576 )) || erro "sem espaço no destino ($(humano $livre_dest) livres, precisa de $(humano $tam))"

  print -r -- "${B}Mover $(humano $tam)${N}"
  print -r -- "  de:   $(curto "$orig")"
  print -r -- "  para: $final"
  print -r -- "  No lugar fica um atalho — os apps continuam achando os arquivos."
  print -r -- "  ${Y}Feche os apps que usam essa pasta antes de continuar.${N}"
  print -r -- "  ${Y}Depois, deixe o HD conectado quando for usar esses arquivos.${N}"
  confirmar "Continuar?" || { print -r -- "Cancelado."; return 0; }

  print -r -- "Copiando…"
  mkdir -p "$final" || erro "não consegui criar $final"
  rsync -rt "$orig/" "$final/" || erro "a cópia falhou — nada foi apagado do Mac"

  local n1 n2 b1 b2
  n1=$(contar "$orig") n2=$(contar "$final")
  b1=$(bytes "$orig")  b2=$(bytes "$final")
  if [[ $n1 != $n2 || $b1 != $b2 ]]; then
    erro "a cópia não bateu ($n1 vs $n2 arquivos) — nada foi apagado do Mac. Cópia parcial em: $final"
  fi
  print -r -- "  ${G}✓${N} Cópia conferida: $n2 arquivos, $(humano $(( b2 / 1024 )))"

  rm -rf "$orig" && ln -s "$final" "$orig" || erro "copiei, mas não consegui trocar a pasta pelo atalho"
  log "moveu: $orig → $final ($(humano $tam))"
  print -r -- "  ${G}✓${N} Pronto. Livre agora: $(humano $(livre_kb))"
}

# ─── análise geral (primeira vez e sob demanda) ───────────────────────────

CACHE_GERAL="$DIR_CONF/geral.cache"

primeira_feita()  { grep -q '^primeira=' "$ESTADO" 2>/dev/null; }
marcar_primeira() { mkdir -p "$DIR_CONF"; primeira_feita || print -r -- "primeira=$(date +%s)" >> "$ESTADO"; }

# linhas da análise: usa a medição dos últimos 15 min se existir (medir tudo leva ~30 s)
linhas_geral() {
  if [[ -f $CACHE_GERAL && $1 != --nova ]] && (( $(date +%s) - $(stat -f %m "$CACHE_GERAL") < 900 )); then
    cat "$CACHE_GERAL"
  else
    mkdir -p "$DIR_CONF"
    listar_geral | tee "$CACHE_GERAL"
  fi
}

# Limpa as linhas recebidas (formato de listar_geral). Confere de novo se o app
# não foi aberto nesse meio-tempo. Define LIBERADO_KB, LIXEIRA_KB, LIMPOS e PULADOS.
limpar_linhas() {
  local l id nivel t quem desc nota tipo cam cond
  LIBERADO_KB=0 LIXEIRA_KB=0 LIMPOS=0 PULADOS=()
  for l in "$@"; do
    IFS='|' read -r id nivel t quem desc nota tipo cam <<< "$l"
    [[ -e $cam ]] || continue
    cond=$(alvos | awk -F'|' -v c="$cam" -v t="$tipo" '$4==c && $2==t {print $5; exit}')
    quem=$(quem_usa "$tipo" "$cam" "$cond")
    if [[ -n $quem ]]; then PULADOS+=("$desc|$quem"); continue; fi
    apagar_alvo "$tipo" "$cam"
    if vai_pra_lixeira "$tipo"; then (( LIXEIRA_KB += t )); else (( LIBERADO_KB += t )); fi
    (( LIMPOS++ ))
    log "análise geral: $desc ($(humano $t))$(vai_pra_lixeira "$tipo" && print ' → Lixeira')"
  done
  rm -f "$CACHE_GERAL"
  marcar_primeira
}

comemorar() {   # $1 = livre antes (KB)
  local agora=$(livre_kb)
  print -r -- ""
  print -r -- "  ${G}════════════════════════════════════════════════════${N}"
  if (( LIBERADO_KB > 0 )); then
    print -r -- "   🎉  ${B}Você liberou $(humano $LIBERADO_KB) que estavam escondidos!${N}"
  else
    print -r -- "   ✅  ${B}Pronto!${N}"
  fi
  print -r -- "       Antes: $(humano $1) livres  →  Agora: ${B}$(humano $agora) livres${N}"
  if (( LIXEIRA_KB > 0 )); then
    print -r -- ""
    print -r -- "   🗑️   Mais ${B}$(humano $LIXEIRA_KB)${N} foram pra Lixeira (dá pra recuperar)."
    print -r -- "       Pra liberar de vez: ${C}disco-livre esvaziar-lixeira${N}"
  fi
  local p q
  for p in $PULADOS; do
    print -r -- "   ${Y}⚠${N}  Pulei ${p%%|*}: o ${p##*|} estava aberto."
  done
  print -r -- "  ${G}════════════════════════════════════════════════════${N}"
  if (( LIBERADO_KB >= 10485760 )); then
    print -r -- ""
    print -r -- "   ☕ ${B}Que tal me pagar um café?${N} Foram $(humano $LIBERADO_KB) a menos no seu Mac."
    print -r -- "      O Disco Livre é grátis e vai continuar assim. Um Pix de qualquer valor ajuda."
    print -r -- "      Chave Pix: ${B}c6a0d335-775a-4a2e-bb7a-2dfbf3f2cb67${N}  ${D}(Willian Claf)${N}"
    print -r -- "      ${D}Pra copiar o Pix Copia e Cola: disco-livre apoiar${N}"
  elif (( LIBERADO_KB > 0 )); then
    print -r -- "   ${D}☕ Curtiu? Me paga um café: disco-livre apoiar${N}"
  fi
  (( LIBERADO_KB > 0 )) && avisar "Disco Livre" "Você liberou $(humano $LIBERADO_KB). Agora: $(humano $agora) livres."
}

cmd_geral() {
  if [[ $1 == --pular ]]; then marcar_primeira; print -r -- "${G}✓${N} Ok, não pergunto mais."; return 0; fi

  print -r -- ""
  print -r -- "${B}🔎 Análise geral do seu Mac${N}"
  print -r -- "   Procurando espaço escondido… ${D}(uns 30 segundos)${N}"
  local -a linhas marc
  linhas=(${(f)"$(linhas_geral --nova)"})
  if (( ${#linhas} == 0 )); then
    print -r -- "   ${G}Seu Mac já está limpo 👌${N}"
    marcar_primeira
    return 0
  fi

  local i id nivel t quem desc nota tipo cam
  for (( i = 1; i <= ${#linhas}; i++ )); do
    IFS='|' read -r id nivel t quem desc nota tipo cam <<< "$linhas[i]"
    [[ $nivel == seguro && -z $quem ]] && marc[i]=1 || marc[i]=0
  done

  _mostrar() {
    local grupo="" sel=0 tot=0 caixa
    print -r -- ""
    for (( i = 1; i <= ${#linhas}; i++ )); do
      IFS='|' read -r id nivel t quem desc nota tipo cam <<< "$linhas[i]"
      if [[ $nivel != $grupo ]]; then
        grupo=$nivel
        [[ $nivel == seguro ]] && print -r -- "  ${B}SEGURO${N} ${D}— se recria sozinho, não perde nada${N}" \
                               || { print -r -- ""; print -r -- "  ${B}REVISE${N} ${D}— é seu: só sai se você marcar${N}"; }
      fi
      (( tot += t ))
      if (( marc[i] )); then caixa="${G}[✓]${N}"; (( sel += t )); else caixa="[ ]"; fi
      printf "   %s %2d  %s%9s%s  %s\n" "$caixa" $i "$B" "$(humano $t)" "$N" "$desc"
      [[ -n $nota ]] && print -r -- "                    ${D}↳ $nota${N}"
      [[ -n $quem ]] && print -r -- "                    ${Y}⚠ feche o $quem pra limpar${N}"
    done
    print -r -- ""
    print -r -- "  Encontrei ${B}$(humano $tot)${N} · Marcado: ${G}${B}$(humano $sel)${N}"
  }

  if [[ ! -t 0 ]]; then
    _mostrar
    print -r -- ""
    print -r -- "  Pra limpar, rode no Terminal: disco-livre geral"
    print -r -- "  (ou, por uma IA: disco-livre dados geral  →  disco-livre limpar-itens <ids>)"
    return 0
  fi

  local r n
  while true; do
    _mostrar
    print -r -- ""
    print -r -- "  ${D}Números pra marcar/desmarcar (ex: 3 7) · t = marcar todo o seguro · r = conferir de novo depois de fechar apps${N}"
    # sem resposta (entrada fechada, Ctrl+D) = sair sem limpar. Nunca limpa por padrão.
    if ! read -r "r?  ${B}Enter${N} pra limpar o que está marcado · ${B}q${N} sai sem limpar: "; then
      print -r -- ""; print -r -- "  Nada foi apagado."
      return 0
    fi
    case $r in
      "") break ;;
      q|Q) print -r -- "  Nada foi apagado."; marcar_primeira; return 0 ;;
      t|T) for (( i = 1; i <= ${#linhas}; i++ )); do
             IFS='|' read -r id nivel t quem desc nota tipo cam <<< "$linhas[i]"
             [[ $nivel == seguro && -z $quem ]] && marc[i]=1
           done ;;
      r|R) print -r -- "  Conferindo…"
           linhas=(${(f)"$(linhas_geral --nova)"}) ;;
      *) for n in ${=r}; do
           [[ $n == <-> ]] && (( n >= 1 && n <= ${#linhas} )) || continue
           IFS='|' read -r id nivel t quem desc nota tipo cam <<< "$linhas[n]"
           if [[ -n $quem ]]; then
             print -r -- "  ${Y}⚠ Feche o $quem primeiro e digite r pra eu conferir de novo.${N}"
             continue
           fi
           (( marc[n] = !marc[n] ))
         done ;;
    esac
  done

  local -a escolhidas
  for (( i = 1; i <= ${#linhas}; i++ )); do (( marc[i] )) && escolhidas+=("$linhas[i]"); done
  if (( ${#escolhidas} == 0 )); then
    print -r -- "  Nada marcado. Nada foi apagado."
    marcar_primeira
    return 0
  fi

  local soma=0 l2
  for l2 in $escolhidas; do (( soma += ${${l2#*|*|}%%|*} )); done
  print -r -- ""
  if ! confirmar "  Limpar $(humano $soma) (${#escolhidas} itens)?"; then
    print -r -- "  Nada foi apagado."
    return 0
  fi

  local antes=$(livre_kb)
  print -r -- "  Limpando…"
  limpar_linhas "${escolhidas[@]}"
  comemorar $antes
}

# Usado pelo app e pelas IAs: limpa só os ids escolhidos
cmd_limpar_itens() {
  local json=0 a
  local -A quer
  for a; do
    case $a in
      --json) json=1 ;;
      *) quer[$a]=1 ;;
    esac
  done
  (( ${#quer} )) || erro "use: disco-livre limpar-itens <id> [<id>…] [--json]  (ids em: disco-livre dados geral)"

  local -a escolhidas
  local l
  for l in ${(f)"$(linhas_geral)"}; do
    (( ${+quer[${l%%|*}]} )) && escolhidas+=("$l")
  done
  local antes=$(livre_kb)
  limpar_linhas "${escolhidas[@]}"

  if (( json )); then
    local p sep=
    print -rn -- "{\"liberado_kb\":$LIBERADO_KB,\"lixeira_kb\":$LIXEIRA_KB,\"itens\":$LIMPOS,\"livre_antes\":$antes,\"livre_depois\":$(livre_kb),\"pulados\":["
    for p in $PULADOS; do
      print -rn -- "$sep{\"desc\":$(js "${p%%|*}"),\"quem\":$(js "${p##*|}")}"; sep=,
    done
    print -r -- "]}"
  else
    comemorar $antes
  fi
}

cmd_esvaziar_lixeira() {
  if [[ $1 != --sim ]]; then
    confirmar "Esvaziar a Lixeira? Isso apaga de vez o que está lá." || { print -r -- "Cancelado."; return 0; }
  fi
  local antes=$(livre_kb)
  osascript -e 'tell application "Finder" to empty trash' >/dev/null 2>&1 || erro "não consegui esvaziar (o macOS pode pedir permissão pra controlar o Finder)"
  log "esvaziou a Lixeira"
  print -r -- "${G}✓${N} Lixeira esvaziada. Livre agora: $(humano $(livre_kb)) (antes $(humano $antes))"
}

# ─── me paga um café ──────────────────────────────────────────────────────

PIX_CHAVE="c6a0d335-775a-4a2e-bb7a-2dfbf3f2cb67"
PIX_COPIA_E_COLA="00020126580014br.gov.bcb.pix0136c6a0d335-775a-4a2e-bb7a-2dfbf3f2cb675204000053039865802BR5912WILLIAN CLAF6014SANTA CATARINA62070503***6304C34D"

cmd_apoiar() {
  print -rn -- "$PIX_COPIA_E_COLA" | pbcopy 2>/dev/null
  print -r -- ""
  print -r -- "  ☕ ${B}Me paga um café?${N}"
  print -r -- "  O Disco Livre é grátis e vai continuar grátis. Se ele te ajudou,"
  print -r -- "  um Pix de qualquer valor me ajuda a manter e melhorar."
  print -r -- ""
  print -r -- "  ${G}✓${N} Pix Copia e Cola ${B}já está copiado${N}: é só colar no app do banco."
  print -r -- "  Chave Pix: ${B}$PIX_CHAVE${N}  ${D}(Willian Claf)${N}"
  print -r -- "  QR Code: no app (☕ no rodapé) ou em github.com/Willclaf/disco-livre#apoie"
  print -r -- ""
  print -r -- "  Valeu demais! 💚"
}

# ─── atualização ──────────────────────────────────────────────────────────

ultima_versao() {
  curl -fsL --max-time 6 "https://api.github.com/repos/Willclaf/disco-livre/releases/latest" 2>/dev/null |
    sed -n 's/.*"tag_name": *"v\{0,1\}\([^"]*\)".*/\1/p' | head -1
}

# verdadeiro se $1 for uma versão mais nova que $2
mais_nova() {
  [[ -n $1 && $1 != $2 ]] || return 1
  [[ $(printf '%s\n%s\n' "$1" "$2" | sort -t. -k1,1n -k2,2n -k3,3n | tail -1) == $1 ]]
}

cmd_atualizar() {
  local nova=$(ultima_versao)
  [[ -n $nova ]] || erro "não consegui ver a última versão (está sem internet?)"
  if [[ $1 == --checar ]]; then
    mais_nova "$nova" "$VERSAO" && print -r -- "$nova"
    return 0
  fi
  if ! mais_nova "$nova" "$VERSAO" && [[ $1 != --forcar ]]; then
    print -r -- "${G}✓${N} Você já está na versão mais nova ($VERSAO)."
    return 0
  fi
  print -r -- "Atualizando o Disco Livre $VERSAO → $nova… ${D}(suas configurações ficam como estão)${N}"
  zsh -c "$(curl -fsSL https://raw.githubusercontent.com/Willclaf/disco-livre/main/instalar.sh)" -- --sim --nao-abrir || erro "a atualização falhou"
  log "atualizou: $VERSAO → $nova"
  [[ -d "/Applications/Disco Livre.app" || -d "$HOME/Applications/Disco Livre.app" ]] && open -a "Disco Livre"
  return 0
}

# ─── dados pro app (JSON) ─────────────────────────────────────────────────

js()   { local s=${1//\\/\\\\}; s=${s//\"/\\\"}; s=${s//$'\t'/ }; print -rn -- "\"$s\""; }
bool() { (( $1 )) && print -rn true || print -rn false; }

cmd_dados() {
  local sep t desc b tipo cam n app c label info prog porta perfil p
  case ${1:-resumo} in
    resumo)
      local tend=$(tendencia_kb) at=0 al=0
      ativo && at=1
      [[ $AUTO_LIMPEZA == sim ]] && al=1
      print -rn -- "{\"versao\":\"$VERSAO\",\"livre\":$(livre_kb),\"total\":$(total_kb),\"meta_kb\":$(gb_kb $META_GB),\"meta_gb\":$META_GB"
      print -rn -- ",\"vigilancia\":$(bool $at),\"auto_limpeza\":$(bool $al),\"intervalo\":$INTERVALO_HORAS"
      print -rn -- ",\"tendencia_kb\":${tend:-null},\"primeira_feita\":$(primeira_feita && print -n true || print -n false)"

      print -rn -- ",\"lixo\":["; sep=
      while IFS='|' read -r t desc b tipo cam; do
        print -rn -- "$sep{\"kb\":$t,\"desc\":$(js "$desc"),\"bloqueado\":$(bool $b),\"cam\":$(js "$cam")}"; sep=,
      done < <(listar_lixo)

      print -rn -- "],\"crashes\":["; sep=
      while IFS='|' read -r n t app c; do
        print -rn -- "$sep{\"n\":$n,\"kb\":$t,\"app\":$(js "$app"),\"cam\":$(js "$c")}"; sep=,
      done < <(listar_crashes)

      print -rn -- "],\"tarefas\":["; sep=
      while IFS='|' read -r tipo label info prog; do
        print -rn -- "$sep{\"tipo\":$(js "$tipo"),\"label\":$(js "$label"),\"info\":$(js "$info"),\"prog\":$(js "$prog")}"; sep=,
      done < <(listar_tarefas)

      print -rn -- "],\"remoto\":["; sep=
      while IFS='|' read -r app porta perfil; do
        print -rn -- "$sep{\"app\":$(js "$app"),\"porta\":$(js "$porta"),\"perfil\":$(js "$perfil")}"; sep=,
      done < <(listar_remoto)
      print -r -- "]}"
      ;;
    pastas)
      print -rn -- "["; sep=
      while IFS='|' read -r t p; do
        oculta "$p" && b=1 || b=0
        print -rn -- "$sep{\"kb\":$t,\"cam\":$(js "$p"),\"oculta\":$(bool $b),\"dica\":$(js "$(dica "$p")")}"; sep=,
      done < <(listar_maiores 20)
      print -r -- "]"
      ;;
    geral)
      local id nivel quem nota
      print -rn -- "{\"livre\":$(livre_kb),\"itens\":["; sep=
      while IFS='|' read -r id nivel t quem desc nota tipo cam; do
        vai_pra_lixeira "$tipo" && b=1 || b=0
        print -rn -- "$sep{\"id\":$(js "$id"),\"nivel\":$(js "$nivel"),\"kb\":$t,\"quem\":$(js "$quem"),\"desc\":$(js "$desc"),\"nota\":$(js "$nota"),\"lixeira\":$(bool $b)}"; sep=,
      done < <(linhas_geral --nova)
      print -r -- "]}"
      ;;
    *) erro "use: disco-livre dados resumo|pastas|geral" ;;
  esac
}

cmd_ajuda() {
  cat <<EOF
${B}disco-livre${N} — mantém seu Mac com espaço livre

${B}Uso:${N}
  disco-livre                      resumo: espaço livre, meta e vigilância
  disco-livre geral                análise geral: acha o espaço escondido e você escolhe o que limpar
  disco-livre analisar             raio-x completo: o que ocupa espaço e por quê
  disco-livre limpar               mostra o lixo seguro (simulação)
  disco-livre limpar --executar    apaga o lixo seguro (pede confirmação)
  disco-livre esvaziar-lixeira     esvazia a Lixeira (pede confirmação)
  disco-livre atualizar            instala a versão mais nova (mantém suas configurações)
  disco-livre apoiar               ☕ me paga um café (Pix)
  disco-livre mover <pasta> <dest> move uma pasta pro HD externo e deixa um atalho

  disco-livre ativar               liga a vigilância automática
  disco-livre desativar            desliga a vigilância automática
  disco-livre config               mostra/muda a configuração
  disco-livre config meta 30       espaço livre mínimo (GB)
  disco-livre config auto-limpeza sim   limpa sozinho quando passar da meta

  disco-livre pausar-tarefa <nome>  para uma tarefa em segundo plano (reversível)
  disco-livre religar-tarefa <nome> religa uma tarefa pausada

${B}O que a vigilância faz${N} (a cada ${INTERVALO_HORAS}h):
  • avisa quando o espaço livre fica abaixo da meta
  • avisa quando o disco perde mais de ${ALERTA_QUEDA_GB} GB em 24h
  • detecta apps crashando em loop e apaga os relatórios
  • se auto-limpeza = sim, limpa o lixo seguro sozinho

Histórico do que foi apagado: $(curto "$LOG")
EOF
}

case ${1:-status} in
  status)          cmd_status ;;
  analisar|a)      cmd_analisar ;;
  limpar)          shift; cmd_limpar "$@" ;;
  vigiar)          cmd_vigiar ;;
  dados)           cmd_dados "$2" ;;
  geral)           cmd_geral "$2" ;;
  limpar-itens)    shift; cmd_limpar_itens "$@" ;;
  esvaziar-lixeira) cmd_esvaziar_lixeira "$2" ;;
  apoiar|cafe)     cmd_apoiar ;;
  atualizar)       cmd_atualizar "$2" ;;
  config)          shift; cmd_config "$@" ;;
  ativar)          cmd_ativar ;;
  desativar)       cmd_desativar ;;
  mover)           shift; cmd_mover "$@" ;;
  pausar-tarefa)   cmd_pausar_tarefa "$2" ;;
  religar-tarefa)  cmd_religar_tarefa "$2" ;;
  versao|-v|--version) print -r -- "disco-livre $VERSAO" ;;
  ajuda|-h|--help) cmd_ajuda ;;
  *) print -r -- "Comando desconhecido: $1"; cmd_ajuda; exit 1 ;;
esac
